# =============================================================================
# Zsh configuration
# =============================================================================
# macOS 默认 shell 为 zsh，本文件提供与 bash 等价的体验。
# =============================================================================

# compinstall marker
zstyle :compinstall filename "$HOME/.zshrc"

# 如果 bash 配置文件存在，source 它们以复用通用配置
[[ -f ~/.profile ]] && source ~/.profile
[[ -f ~/.bash_aliases ]] && source ~/.bash_aliases
[[ -f ~/.proxyrc ]] && source ~/.proxyrc

# 确保 ~/.local/bin 在 PATH 中
export PATH="$HOME/.local/bin:$PATH"

# Zsh 历史记录配置
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory
setopt incappendhistory
setopt sharehistory

# 启用一些有用的 zsh 选项
setopt autocd
setopt extendedglob
setopt nomatch
setopt notify
unsetopt beep

# 补全系统
autoload -Uz compinit
compinit

# 提示符
PROMPT='%n@%m:%1~$ '

# ==========================================
# 安全 rsync 快捷方式
# ==========================================
# 实现在 ~/.local/bin/rs：下载默认排除隐藏目录，超过配置阈值时确认。
# 清除 source 旧版 zshrc 后可能残留在当前 shell 里的同名函数。
unfunction rs 2>/dev/null || true
compdef _rsync rs

# 远程补全（ssh/scp）
zstyle ':completion:*:*:scp:*' tag-order 'users:hosts'
zstyle ':completion:*:*:ssh:*' tag-order 'users:hosts'

# ==========================================
# 工具集成
# ==========================================

# Zoxide
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# Fzf
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh 2>/dev/null) || true
fi

# uv / 本地环境变量
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"


# 加载 dircolors 颜色配置
if command -v gdircolors &> /dev/null; then
    eval "$(gdircolors -b)"
fi

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
fpath=(~/.grok/completions/zsh $fpath)
autoload -Uz compinit && compinit -C
# <<< grok installer <<<

