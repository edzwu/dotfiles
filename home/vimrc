" LSP Toggle: 一键开关（释放内存）
let g:lsp_toggled_off = 0

command! LspToggle call s:LspToggle()
function! s:LspToggle() abort
  if get(g:, 'lsp_toggled_off', 0)
    call lsp#enable()
    let g:lsp_toggled_off = 0
    echom 'LSP enabled'
  else
    for s:server in lsp#get_server_names()
      call lsp#stop_server(s:server)
    endfor
    call lsp#disable()
    let g:lsp_toggled_off = 1
    echom 'LSP disabled (servers stopped)'
  endif
endfunction

