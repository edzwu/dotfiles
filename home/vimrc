" ------------------------------
" \c* 系列统一语义（与 \l* 对齐）
" 约定：d = definition，c = 调用者，C = 被调用者（大小写成对）
"   原插件默认 \cd 是 callees（我调了谁），现改为 definition 别名（同 \cg）
"   callees 移到 \cC，与 LSP 的 \lC（outgoing）对齐
"   gtags_plus_nomap=1 已禁用插件默认键位，这里是完整定义
" 老版 gutentags_plus 不认识 Vim 9.1 的 winfixbuf；查询期间临时取消，随后恢复。
" ------------------------------
function! s:GscopeFind(what, is_file) abort
  let l:source_win = win_getid()
  let l:restore_winfixbuf = &l:winfixbuf
  if l:restore_winfixbuf
    setlocal nowinfixbuf
  endif
  try
    let l:keyword = a:is_file ? expand('<cfile>') : expand('<cword>')
    execute 'GscopeFind ' . a:what . ' ' . fnameescape(l:keyword)
  finally
    if l:restore_winfixbuf && win_id2win(l:source_win) > 0
      call win_execute(l:source_win, 'setlocal winfixbuf')
    endif
  endtry
endfunction

