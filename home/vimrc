" GUI apps such as Leaf may not inherit Homebrew's shell PATH.
if has('macunix')
  " Paths are prepended in order, so Apple Silicon takes precedence.
  for s:brew_path in ['/usr/local/bin', '/opt/homebrew/bin']
    if isdirectory(s:brew_path) && index(split($PATH, ':'), s:brew_path) < 0
      let $PATH = s:brew_path . ':' . $PATH
    endif
  endfor
  unlet! s:brew_path
endif

" Ensure Go binary paths are available in vim (for vim-go)
for s:go_path in ['~/.local/go/bin', '~/go/bin']
  let s:expanded = expand(s:go_path)
  if isdirectory(s:expanded) && index(split($PATH, ':'), s:expanded) < 0
    let $PATH = s:expanded . ':' . $PATH
  endif
endfor
unlet! s:go_path s:expanded

" Ensure Node.js binary path is available in vim (for LSP servers like pyright)
" Check pi-node first (version-agnostic glob), then nvm
for s:node_path in glob('~/.local/share/pi-node/*/bin', 1, 1)
  if isdirectory(s:node_path) && index(split($PATH, ':'), s:node_path) < 0
    let $PATH = s:node_path . ':' . $PATH
  endif
endfor
for s:node_path in glob('~/.nvm/versions/node/*/bin', 1, 1)
  if isdirectory(s:node_path) && index(split($PATH, ':'), s:node_path) < 0
    let $PATH = s:node_path . ':' . $PATH
  endif
endfor
unlet! s:node_path

